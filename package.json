{
  "name": "rustrak",
  "private": true,
  "scripts": {
    "ci": "turbo run test build lint format:check check-types doctor",
    "build": "turbo run build",
    "build:dev": "turbo run build:dev",
    "build:docs": "turbo run build --filter=docs",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=docs",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check-types": "turbo run check-types",
    "doctor": "react-doctor",
    "doctor:json": "react-doctor --json --json-out react-doctor-report.json",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version && bash scripts/sync-version.sh",
    "release": "changeset publish",
    "update:monorepo": "pnpx npm-check-updates -i --deep --doctorInstall pnpm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "react-doctor": "0.9.12",
    "turbo": "2.10.11",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "nextra>zod": "4.3.5",
      "nextra-theme-docs>zod": "4.3.5",
      "next>@swc/helpers": "0.5.15"
    }
  }
}
