{
  "name": "@rustrak/mcp",
  "version": "0.1.1",
  "description": "MCP server for Rustrak error tracking — wraps @rustrak/client",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rustrak-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rustrak",
    "mcp",
    "model-context-protocol",
    "error-tracking",
    "claude"
  ],
  "license": "GPL-3.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@rustrak/client": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
