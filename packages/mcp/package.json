{
  "name": "@rustrak/mcp",
  "version": "0.2.9",
  "description": "MCP server that gives AI assistants (Claude, Cursor, Continue) full control of your Rustrak error tracking",
  "homepage": "https://rustrak.github.io/rustrak/sdks/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/rustrak/rustrak.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/rustrak/rustrak/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rustrak-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rustrak",
    "mcp",
    "model-context-protocol",
    "error-tracking",
    "sentry",
    "self-hosted",
    "claude",
    "cursor",
    "ai",
    "monitoring",
    "observability"
  ],
  "author": "AbianS",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@rustrak/client": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
