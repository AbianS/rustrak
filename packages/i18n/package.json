{
  "name": "@rustrak/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "messages"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/*": "./messages/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/compile-catalogs.mjs && tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src scripts",
    "format": "biome format --write src scripts",
    "format:check": "biome format src scripts",
    "clean": "rm -rf dist src/generated .turbo"
  },
  "dependencies": {
    "@lingui/core": "6.6.0"
  },
  "devDependencies": {
    "@lingui/message-utils": "6.6.0",
    "@types/node": "26.2.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
