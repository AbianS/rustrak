{
  "name": "@rustrak/server",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "build": "cargo build --release",
    "build:dev": "cargo build",
    "dev": "cargo watch -x run",
    "start": "cargo run --release",
    "test": "cargo test",
    "coverage": "cargo llvm-cov --summary-only",
    "coverage:html": "cargo llvm-cov --html --output-dir coverage",
    "coverage:lcov": "cargo llvm-cov --lcov --output-path lcov.info",
    "lint": "cargo clippy -- -D warnings",
    "check-types": "cargo check",
    "clean": "cargo clean",
    "format": "cargo fmt",
    "format:check": "cargo fmt -- --check"
  }
}
