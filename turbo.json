{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": ["biome.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "out/**",
        "target/release/**",
        "!target/release/.fingerprint/**",
        "!target/release/deps/**",
        "!target/release/build/**",
        "!target/release/.cargo-lock",
        "dist/**"
      ]
    },
    "build:dev": {
      "dependsOn": ["^build:dev"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "target/debug/**",
        "!target/debug/.fingerprint/**",
        "!target/debug/deps/**",
        "!target/debug/build/**",
        "!target/debug/.cargo-lock"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "//#doctor": {
      "inputs": [
        "doctor.config.json",
        "apps/*/src/**",
        "apps/*/package.json",
        "packages/*/src/**",
        "packages/*/package.json",
        "pnpm-lock.yaml"
      ]
    },
    "@rustrak/server#build": {
      "dependsOn": ["^build", "@rustrak/dashboard#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "static/**",
        "target/release/**",
        "!target/release/.fingerprint/**",
        "!target/release/deps/**",
        "!target/release/build/**",
        "!target/release/.cargo-lock"
      ]
    },
    "@rustrak/server#build:dev": {
      "dependsOn": ["^build:dev", "@rustrak/dashboard#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "static/**",
        "target/debug/**",
        "!target/debug/.fingerprint/**",
        "!target/debug/deps/**",
        "!target/debug/build/**",
        "!target/debug/.cargo-lock"
      ]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"]
    },
    "webview-ui#check-types": {
      "dependsOn": ["^check-types", "^build", "build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "@rustrak/ui#test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@rustrak/dashboard#dev": {
      "dependsOn": ["@rustrak/ui#build", "@rustrak/client#build"],
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "clean": {
      "cache": false
    },
    "bench": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "scenarios/**"]
    },
    "bench:baseline": {
      "dependsOn": ["build"],
      "cache": false
    },
    "bench:burst": {
      "dependsOn": ["build"],
      "cache": false
    },
    "bench:sustained": {
      "dependsOn": ["build"],
      "cache": false
    },
    "bench:stress": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
